{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:create_fastapi_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "MCP: FastMCP Apps dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "fastmcp",
      "args": [
        "dev",
        "apps",
        "backend/app/mcp/dev_server.py:mcp",
        "--mcp-port",
        "8001",
        "--dev-port",
        "8080",
        "--no-reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
