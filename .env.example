OPENAI_API_KEY=
APP_SIGNING_SECRET=

# Clerk auth; leave empty for local-dev auth only.
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional local/deployment overrides
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./.local/openai-vectorstore2.db
DATABASE_SCHEMA_MODE=migrations
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local/storage
LOG_FILE_PATH=.local/logs/openai-vectorstore2.log
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUP_COUNT=3
VITE_API_BASE_URL=/api
VITE_CHATKIT_DOMAIN_KEY=domain_pk_local_vectorstore2

# Agent provider selection. openai_responses remains the highest-capability default.
AGENT_MODEL_PROVIDER=openai_responses
CHAT_COMPLETIONS_MODEL=gpt-5.4-mini
CHAT_COMPLETIONS_BASE_URL=
CHAT_COMPLETIONS_API_KEY=
CHAT_COMPLETIONS_CONTEXT_WINDOW_TOKENS=
CHAT_COMPLETIONS_OUTPUT_TOKEN_RESERVE=4096
CHAT_COMPLETIONS_COMPACTION_REMAINING_RATIO=0.25
CHAT_COMPLETIONS_COMPACTION_COMPRESS_RATIO=0.50
CHAT_COMPLETIONS_ON_PREM_PRICE_PER_MILLION_TOKENS=1.0
CHAT_COMPLETIONS_WEB_SEARCH_URL=

# Admin, credits, and payment provider integration
ADMIN_INTEGRATION_PROVIDER=default
ADMIN_SHARED_MODULE=backend.app.admin.shared_adapter
BILLING_ENABLED=true
BILLING_DEFAULT_CREDIT_FLOOR_USD=-1.0
BILLING_PLATFORM_MARKUP_MULTIPLIER=1.3
BILLING_UNKNOWN_MODEL_POLICY=zero
PAYPAL_RECIPIENT_EMAIL=
PAYPAL_PAYMENT_URL=
PAYPAL_MIN_PAYMENT_USD=5.0
PAYPAL_MAX_PAYMENT_USD=250.0
PAYPAL_TEMPORARY_ACCESS_DAYS=14

# Optional S3-compatible storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_URL_STYLE=path
